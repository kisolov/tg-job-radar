# --- обязательные ---
DATABASE_URL=postgresql+asyncpg://radar:radar@db:5432/radar
# Бот необязателен: без BOT_TOKEN находки только в веб-панели (тогда обязателен WEB_PASSWORD)
OWNER_TELEGRAM_ID=
BOT_TOKEN=
# Fernet-ключ: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
USERBOT_STORE_KEY=
NEUROAPI_BASE_URL=https://neuroapi.host/v1
NEUROAPI_KEY=
NEUROAPI_MODEL=gpt-4o-mini

# --- дефолт для `radar accounts login` ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
USERBOT_DEVICE_PROFILE=default

# --- темп вступлений (автоторможение) ---
JOIN_DAILY_MIN=25
JOIN_DAILY_MAX=30
JOIN_INTERVAL_MIN_S=300
JOIN_INTERVAL_MAX_S=600
RESOLVE_INTERVAL_S=60
RESOLVE_DAILY_MIN=150
RESOLVE_DAILY_MAX=180
THROTTLE_FACTOR=1.5
THROTTLE_MAX_FACTOR=8.0
THROTTLE_LIMIT_STEP=5
THROTTLE_LIMIT_FLOOR=5
THROTTLE_RECOVERY_DAYS=3
MEMBERSHIP_CAP=500
CHANNEL_POLL_INTERVAL_S=300

# --- расход LLM ---
LLM_BATCH_SIZE=10
LLM_BATCH_WAIT_S=60
LLM_MAX_CHARS=1500
LLM_DAILY_TOKEN_LIMIT=2000000
LLM_PRICE_PER_1K_PROMPT=0.0
LLM_PRICE_PER_1K_COMPLETION=0.0

# --- предфильтр и дедуп (списки через запятую; пусто = дефолт из кода) ---
PREFILTER_MIN_LEN=60
# PREFILTER_MARKERS=
# PREFILTER_STOPWORDS=
# AGGREGATOR_DOMAINS=
DEDUP_WINDOW_DAYS=7
DEDUP_JACCARD=0.6
CLAIM_STALE_S=600
MESSAGES_RETENTION_DAYS=7

# --- веб-панель (вход: /web в боте) ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_BASE_URL=http://localhost:8080
# WEB_SECRET=
# пароль панели; без бота обязателен
WEB_PASSWORD=
